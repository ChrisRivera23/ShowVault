SHOWVAULT_VERSION=0.2.0-prototype
SHOWVAULT_API_PORT=8080

POSTGRES_DB=showvault
POSTGRES_USER=showvault
POSTGRES_PASSWORD=replace-with-a-generated-secret

AUTH0_DOMAIN=replace-with-your-auth0-domain
AUTH0_AUDIENCE=https://api.showvault.app

SHOWVAULT_S3_BUCKET=replace-with-a-private-bucket
SHOWVAULT_S3_PREFIX=showvault/v1
SHOWVAULT_S3_SERVICE_URL=
SHOWVAULT_S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1

# Prefer a workload role in deployed environments. For a bounded local emulator
# only, provide disposable values through the shell or an ignored .env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
